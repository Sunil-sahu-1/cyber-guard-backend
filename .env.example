# ============================================================
# DJANGO / DEVELOPMENT
# ============================================================
DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_DB=cyber_guard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# ============================================================
# CORS / CSRF - LOCAL NEXT.JS FRONTEND
# ============================================================
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
# Optional. If empty, Django SECRET_KEY is used.
JWT_SIGNING_KEY=

# ============================================================
# LOGIN PROTECTION
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# ============================================================
# CACHE
# ============================================================
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=guard-local-cache

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# PROXY
# Keep False for normal local development.
# ============================================================
TRUST_PROXY_HEADERS=False

# ============================================================
# CLOUDFLARE TURNSTILE (OPTIONAL)
# ============================================================
TURNSTILE_SECRET_KEY=

# ============================================================
# PASSWORD RESET EMAIL
# ============================================================
# Local development can keep the console backend; the reset
# email/link will be printed in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@cyberguard.local
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=1800

# For real email delivery, replace EMAIL_BACKEND and configure:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
